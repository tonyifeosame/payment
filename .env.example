APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# MAIL_MAILER=smtp

# This file is committed and the repository is public: placeholders only.
# Real SMTP credentials go in your untracked .env locally and in the hosting
# provider's environment (Render: sync:false keys) in production — never here.
# CI's secret scan (.gitleaks.toml) fails any commit that assigns a literal
# value to MAIL_PASSWORD / SMTP_PASSWORD.
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
# Laravel 12 builds the SMTP DSN from MAIL_SCHEME (smtp = STARTTLS on 587,
# smtps = implicit TLS on 465). MAIL_ENCRYPTION is no longer read by the framework.
MAIL_SCHEME=
# Must be a real, send-authorised mailbox on your own domain in production.
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Seconds before an unresponsive SMTP server fails the send (config/mail.php).
MAIL_TIMEOUT=10
# Where the contact form delivers; empty falls back to MAIL_FROM_ADDRESS.
CONTACT_EMAIL=


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PAYMENT_URL=https://api.paystack.co

# Payout safety (H3): hours a school's payouts are held after its bank account
# changes. Approve schools with `php artisan schools:approve-payouts`.
PAYOUT_BANK_CHANGE_HOLD_HOURS=48

# School admin passwords (M5): minimum length, and refusal of passwords known
# from data breaches (Have I Been Pwned range API; fails open if unreachable).
SCHOOL_PASSWORD_MIN_LENGTH=10
SCHOOL_PASSWORD_BREACH_CHECK=true
